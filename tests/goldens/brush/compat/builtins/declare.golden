=== 30: Displaying functions with compound bodies
status: 0
bash-n: 0
--- stdout
|f () 
|{ 
|    local x=1;
|    if [ 1 ]; then
|        echo "a b";
|    fi;
|    for i in 1 2;
|    do
|        :;
|    done
|}
|g () 
|{ 
|    if [ 1 ]; then
|        echo a;
|        echo b;
|    else
|        echo c;
|    fi
|}
|h () 
|{ 
|    while :; do
|        break;
|    done;
|    { 
|        echo a
|    };
|    case x in 
|        a)
|            echo b
|        ;;
|    esac
|}
|i () 
|{ 
|    until :; do
|        echo x;
|    done;
|    ( echo s;
|    echo t )
|}

=== 31: Displaying a function whose compound commands have redirections
status: 0
bash-n: 0
--- stdout
|f () 
|{ 
|    if true; then
|        :;
|    fi 2>&1;
|    while false; do
|        :;
|    done 3> /dev/null;
|    { 
|        :
|    } 2> /dev/null
|}
|g () 
|{ 
|    [[ -n x ]] 2>&1 | cat
|}

=== 32: Displaying a function with case patterns
status: 0
