=== 5: PROMPT_COMMAND
status: 0
bash-n: 0
--- stdout
|declare -a calls=([0]="0" [1]="0" [2]="first" [3]="second" [4]="third" [5]="third")
--- stderr
|bash: cannot set terminal process group (-1): Inappropriate ioctl for device
|bash: no job control in this shell
|test$ declare -a calls=()
|test$ command=0
|test$ 
|test$ PROMPT_COMMAND='calls+=("$command")'
|test$ 
|test$ command=first
|test$ command=second
|test$ command=third
|test$ 
|test$ unset PROMPT_COMMAND
|test$ 
|test$ declare -p calls
|test$ exit

