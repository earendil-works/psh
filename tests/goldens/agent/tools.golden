|  if ! ls "$dir"/*_test.go >/dev/null 2>&1; then printf '?   \t%s\t[no test files]\n' "$pkg"; continue; fi
|  if grep -q 't.Fatal' "$dir"/*_test.go; then
|    grep -h '^func Test' "$dir"/*_test.go | sed 's/^func \(Test[A-Za-z0-9]*\).*/--- FAIL: \1 (0.00s)/'
|    printf 'FAIL\nFAIL\t%s\t0.01s\n' "$pkg"; rc=1
|  else
|    printf 'ok  \t%s\t0.01s\n' "$pkg"
|  fi
|done
|[ $rc = 1 ] && echo FAIL
|exit $rc
--- dir svc
--- dir svc/api
--- file svc/api/api.go
|package api
--- file svc/api/api_test.go
|package api
|
|func TestRoutes(t *testing.T) {}
--- dir svc/cmd
--- file svc/cmd/main.go
|package main
--- file svc/go.mod
|module example.com/svc
|
|go 1.22
--- dir svc/store
--- file svc/store/store.go
|package store
--- file svc/store/store_test.go
|package store
|
|func TestGet(t *testing.T) {}

