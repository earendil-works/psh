--- stdout
|f () 
|{ 
|    case "$1" in 
|        a | b | c)
|            echo abc
|        ;;
|        d | e)
|            echo de
|        ;;
|        single)
|            echo one
|        ;;
|        *)
|
|        ;;
|    esac
|}

