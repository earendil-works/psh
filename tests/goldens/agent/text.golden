=== 43: gh api --jq through a stub
status: 0
bash-n: 0
--- stdout
|{"number":7,"title":"Speed up lexer","author":"ada"}
|{"number":9,"title":"Docs","author":"bob"}
--- dir bin
--- file bin/gh
|filter=.
|while [ $# -gt 0 ]; do
|  case $1 in
|    --jq) filter=$2; shift ;;
|  esac
|  shift
|done
|exec jq -c "$filter" pulls.json
--- file pulls.json
|[{"number": 7, "title": "Speed up lexer", "user": {"login": "ada"}}, {"number": 9, "title": "Docs", "user": {"login": "bob"}}]

