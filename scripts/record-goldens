#!/usr/bin/env bash
# Record the goldens: run every case under GNU bash 5.3 in the pinned recording container
# (docker/Dockerfile) and write tests/goldens/ (TESTING.md "Oracle", "Cases and
# goldens"). Re-recording is rare and deliberate: commit it on its own and review the
# diff.
#
#   scripts/record-goldens [FILTER...]          record (all cases, or the filtered ones)
#   scripts/record-goldens --check [FILTER...]  record into a scratch directory and
#                                               compare with tests/goldens per case
#   scripts/record-goldens --l0 [--check]       only the L0 verdicts below (seconds)
#   scripts/record-goldens --bsd [FILTER...]    the BSD goldens of L4, on macOS
#
# --check is the determinism check: a second recording must reproduce the committed
# goldens. Cases that differ are listed; inherently nondeterministic ones belong in a
# group in tests/spec.toml.
#
# Every case golden holds `bash -n` on the case's script. An unfiltered recording (and
# --l0) also records `bash -n` for every skeleton of the shape corpus and every snippet
# of tests/l0/syntax.txt into tests/goldens/{shapes,l0}/bash-n.txt (L0).
#
# Needs Docker. The first run builds the image (bash from the GNU tarball, slow once).
# psh-spec is built for Linux in the pinned Rust image. Output goes through
# work/scratch/record/ and is copied into tests/goldens/ only when the recording
# succeeded.
set -euo pipefail
cd "$(dirname "$0")/.."
root=$(pwd)

# The BSD goldens of L4 are recorded on macOS itself, with Homebrew's bash 5.3 and only
# the system's directories on PATH (psh-spec --record --bsd).
if [ "${1:-}" = --bsd ]; then
  shift
  if [ "$(uname -s)" != Darwin ]; then
    echo "record-goldens --bsd: run this on macOS" >&2
    exit 2
  fi
  bash53=${PSH_BSD_BASH:-/opt/homebrew/bin/bash}
  case "$("$bash53" -c 'echo $BASH_VERSION' 2>/dev/null)" in
    5.3.*) ;;
    *) echo "record-goldens --bsd: $bash53 is not bash 5.3 (set PSH_BSD_BASH)" >&2; exit 2 ;;
  esac
  cargo build -q -p psh -p psh-spec
  exec target/debug/psh-spec --record --bsd --shell "$bash53" -j 8 "$@"
fi

l0_only=0
if [ "${1:-}" = --l0 ]; then
  l0_only=1
  shift
fi
check=0
if [ "${1:-}" = --check ]; then
  check=1
  shift
fi

rust_image=rust:1.96-trixie@sha256:1f0dbad1df66647807e6952d1db85d0b2bda7606cb2139d82517e4f009967376
# The image tag follows the Dockerfile's content, so an edit rebuilds it.
tag=psh-goldens:$(git hash-object docker/Dockerfile | cut -c1-12)
if ! docker image inspect "$tag" >/dev/null 2>&1; then
  echo "== building $tag (bash from source; the download can take minutes)"
  docker build -q -t "$tag" docker/ >/dev/null
fi

echo "== building psh-spec for Linux"
mkdir -p target/record
docker run --rm --user "$(id -u):$(id -g)" -v "$root:/src" -w /src \
  -e CARGO_HOME=/src/target/record/cargo-home -e CARGO_TARGET_DIR=/src/target/record \
  "$rust_image" cargo build -q --release --locked -p psh-spec

out=work/scratch/record
rm -rf "$out"
mkdir -p "$out"
# A filtered recording replaces its cases inside the existing golden files.
if { [ $# -gt 0 ] || [ $l0_only = 1 ]; } && [ -d tests/goldens ]; then
  cp -R tests/goldens/. "$out"/
fi
chmod -R a+rwX "$out"
echo "== recording in $tag"
# The repository is read-only inside; goldens are written to $out. A fixed hostname
# (normalized to <host> anyway); the image fixes the user, locale, TZ and umask. No
# network.
jobs=$(docker run --rm "$tag" nproc)
if [ $l0_only = 0 ]; then
  docker run --rm --network none --hostname psh-oracle \
    -v "$root:/src:ro" -v "$root/$out:/out" \
    "$tag" /src/target/record/release/psh-spec --root /src --record \
    --shell /usr/local/bin/bash --goldens /out -j "$jobs" "$@"
fi
# L0's parse-only inputs: bash -n verdicts only.
if [ $# -eq 0 ]; then
  docker run --rm --network none --hostname psh-oracle \
    -v "$root:/src:ro" -v "$root/$out:/out" \
    "$tag" /src/target/record/release/psh-spec --root /src --record-l0 \
    --shell /usr/local/bin/bash --goldens /out -j "$jobs"
fi

if [ $check = 1 ]; then
  echo "== comparing with tests/goldens"
  st=0
  for f in shapes/bash-n.txt l0/bash-n.txt; do
    if [ -f "$out/$f" ] && ! diff -u "tests/goldens/$f" "$out/$f"; then
      st=1
    fi
  done
  scripts/timeout.sh 600 cargo run -q -p psh-spec -- --diff-goldens tests/goldens "$out" || st=1
  exit $st
fi

rm -rf tests/goldens
mkdir -p tests/goldens
cp -R "$out"/. tests/goldens/
echo "== tests/goldens updated; review with git diff --stat tests/goldens"
