|import os
|import sys
|
|
|def read_config(path):
|    with open(path) as f:
|        return f.read()
|
|
|def write_config(path, data):
|    with open(path, "w") as f:
|        f.write(data)
|
|
|def main():
|    cfg = read_config(sys.argv[1])
|    print(cfg)
|
|
|if __name__ == "__main__":
|    main()

