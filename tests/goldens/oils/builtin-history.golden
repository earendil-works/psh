=== 6: history -d to delete history from end
status: 0
bash-n: 0
--- stdout
|42
|43
|44
|status=0
|status=0
|status=0
|status=1
--- stderr
|bash: cannot set terminal process group (10049): Inappropriate ioctl for device
|bash: no job control in this shell
|bash-5.3$ 
|bash-5.3$ echo 42
|bash-5.3$ echo 43
|bash-5.3$ echo 44
|bash-5.3$ 
|bash-5.3$ history -a
|bash-5.3$ 
|bash-5.3$ history -d 1
|bash-5.3$ echo status=$?
|bash-5.3$ 
|bash-5.3$ history -d -1
|bash-5.3$ echo status=$?
|bash-5.3$ history -d -2
|bash-5.3$ echo status=$?
|bash-5.3$ history -d 99
|bash: history: 99: history position out of range
|bash-5.3$ echo status=$?
|bash-5.3$ 
|bash-5.3$ case $SH in bash*) echo '^D' ;; esac
|bash-5.3$ 
|bash-5.3$ exit
--- file myhist
|echo 42
|echo 43
|echo 44
|history -a
|echo status=$?
|history -d -2
|echo status=$?
|history -d 99
|echo status=$?
|case $SH in bash*) echo '^D' ;; esac

