|entered firstfunc: var=first
|entered secondfunc: var=second
|entered thirdfunc: var=second
|after first unset: var=first
|   ...and updated: var=first:updated
|after second unset: var=global
|   ...and updated: var=global:updated
|after third unset: var=
|   ...and updated: var=:updated
|leaving firstfunc: var=:updated
|leaving secondfunc: var=:updated
|leaving firstfunc: var=:updated
|after calls: var=:updated

