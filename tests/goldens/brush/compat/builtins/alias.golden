# Goldens for tests/brush/brush-shell/tests/cases/compat/builtins/alias.yaml (layer brush), recorded by scripts/record-goldens with
# GNU bash, version 5.3.9(1)-release (aarch64-unknown-linux-gnu).
# Do not edit; re-record instead (TESTING.md "Cases and goldens").

=== 0: Basic alias usage
status: 0
bash-n: 0
--- stdout
|alias myalias='echo'
|hello

=== 1: Alias listing
status: 0
bash-n: 0
--- stdout
|alias a='echo'
|alias b='ls -l'
|---
|alias a='echo'
|alias b='ls -l'
|---
|alias a='echo'
|exit=0

