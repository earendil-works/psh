#!/usr/bin/env python3
"""Turn the private command corpus into the committed shape corpus.

Reads   ~/.cache/psh-corpus/commands.jsonl  (PRIVATE; see research/corpus/extract.py)
Writes  tests/shapes/vocabulary.txt         (`vocab`)
        tests/shapes/shapes.txt             (`build`)

Each command becomes a syntax skeleton: operators, redirections, quoting, here-doc
markers, expansions and keywords stay; every word outside the vocabulary becomes a
placeholder (w1, w2, ... for words, v1, ... for variables, numbered per command in
order of appearance); here-doc bodies and comments become the fixed text `w0`. The
tree comes from tree-sitter-bash, so the shapes never test psh's parser against itself.
Rewriting is substitution on the original text: everything the tree does not explain
is still sanitized word by word, so a tree-sitter misparse can cost fidelity but
never leak text.

Subcommands:
  vocab       count candidate words in the corpus, write vocabulary.txt
  build       write shapes.txt (runs the privacy check on the result)
  parsecheck  run `bash -n` on every skeleton and compare with the originals
              (needs $PSH_CORPUS_DATA/syntax.json from research/corpus/syntaxcheck.py)
  selftest    skeletons of a few hand-written commands

Needs tree-sitter and tree-sitter-bash (local only; never part of the build). Without
them, the script re-runs itself under research/corpus/.venv of the primary checkout.
Nothing here prints raw commands.
"""
import json
import os
import re
import subprocess
import sys
from collections import Counter, defaultdict
from multiprocessing import Pool

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
OUT = os.path.join(ROOT, "tests", "shapes")
VOCAB = os.path.join(OUT, "vocabulary.txt")
SHAPES = os.path.join(OUT, "shapes.txt")
DATA = os.environ.get("PSH_CORPUS_DATA", os.path.expanduser("~/.cache/psh-corpus"))
BASH = "/opt/homebrew/bin/bash"
SCRATCH = os.path.join(ROOT, "work", "scratch", "0003")

try:
    import tree_sitter as ts
    import tree_sitter_bash as tsb
except ImportError:
    common = subprocess.run(["git", "-C", ROOT, "rev-parse", "--path-format=absolute", "--git-common-dir"],
                            capture_output=True, text=True).stdout.strip()
    venv = os.path.join(os.path.dirname(common), "research", "corpus", ".venv", "bin", "python")
    if os.path.exists(venv) and os.path.realpath(sys.executable) != os.path.realpath(venv):
        os.execv(venv, [venv] + sys.argv)
    sys.exit("shape-corpus: needs tree-sitter + tree-sitter-bash (uv venv research/corpus/.venv && "
             "uv pip install --python research/corpus/.venv/bin/python tree-sitter tree-sitter-bash)")

sys.path.insert(0, HERE)
import importlib.machinery  # noqa: E402
import importlib.util  # noqa: E402

_loader = importlib.machinery.SourceFileLoader("shape_check", os.path.join(HERE, "shape-corpus-check"))
_spec = importlib.util.spec_from_loader("shape_check", _loader)
check = importlib.util.module_from_spec(_spec)
_loader.exec_module(check)

# ------------------------------------------------------------------ vocabulary

# Thresholds for words taken from the corpus by frequency (D1031): a candidate must occur
# in at least this many distinct commands, sessions and projects (see project()).
MIN_CMDS, MIN_SESSIONS, MIN_PROJECTS = 20, 5, 3

KEYWORDS = "if then else elif fi case esac for select while until do done in function time coproc".split()
BUILTINS = """alias bg bind break builtin caller cd command compgen complete compopt continue declare dirs
disown echo enable eval exec exit export false fc fg getopts hash help history jobs kill let local logout
mapfile readarray popd printf pushd pwd read readonly return set shift shopt source suspend test times trap
true type typeset ulimit umask unalias unset wait""".split()
# research/builtins.md, tiers 1-3.
UTILITIES = """head tail cat ls cp mv rm mkdir rmdir touch ln chmod basename dirname realpath readlink mktemp
stat du grep egrep fgrep rg fd sed awk sort uniq wc cut tr paste nl tee seq comm sleep find xargs diff cmp jq
base64 md5sum sha1sum sha256sum sha512sum shasum md5 date env printenv timeout gtimeout nice nohup which ps
pgrep pkill uptime nproc id uname whoami hostname df tree column tac rev strings od xxd hexdump hd expr yes
truncate fold expand unexpand join split cksum b2sum sha224sum sha384sum base32 basenc sum shuf patch tar
gzip gunzip zcat unzip sponge ts ifne dos2unix unix2dos iconv install link unlink sync mkfifo logname tty
file bc dc yq bzip2 bunzip2 xz unxz zstd brotli zip dd numfmt fmt pr csplit tsort factor ptx uuidgen getopt
envsubst chown chgrp clear pidwait pidof free who users more less""".split()
# research/builtins.md 4.5, plus the tools research/corpus/analyze.py splits by subcommand.
NEVER = """python python3 node deno bun perl ruby php lua tclsh java osascript pwsh powershell cc gcc clang
rustc cargo go zig swift swiftc tsc make cmake ninja bazel xcodebuild gofmt rustfmt clang-format npm npx
pnpm yarn pip pip3 uv uvx brew apt apt-get rustup bunx curl wget ssh scp sftp rsync nc ping dig openssl gh
aws gcloud kubectl docker podman sqlite3 psql mysql redis-cli postgres vi vim nano top htop watch man tmux
screen fzf stty tput sudo su chroot mount systemctl launchctl crontab sysctl ifconfig networksetup ioreg
dmesg lsof xcrun codesign plutil sips open pbcopy pbpaste say ffmpeg ffprobe magick pdftotext pandoc 7z
hyperfine samply shred git jj just nix fly flyctl wrangler defaults security lldb ollama pi bash sh zsh dash
ksh fish caffeinate stdbuf unbuffer script chronic doas arch""".split()
# Tools whose first argument is one of the tool's own subcommands. Not make, just, pnpm,
# yarn, bun or npx: their first argument names a project's target, script or package.
SUBCMD_TOOLS = """git cargo npm gh docker uv go brew pip pip3 kubectl jj rustup deno swift xcrun
xcodebuild launchctl tmux apt apt-get gcloud aws fly flyctl wrangler sqlite3 podman nix systemctl
defaults security codesign lldb ollama""".split()
# Frequent upper-case variables are kept only without `_` or with a public tool's prefix;
# other prefixes name a project.
PUBLIC_VAR_PREFIXES = ("CARGO_", "RUST", "NODE_", "GIT_", "PG", "PI_", "MIRI", "GO", "NPM_", "PYTHON")
VARIABLES = """HOME PATH PWD OLDPWD IFS USER LOGNAME SHELL TERM LANG LC_ALL LC_CTYPE TMPDIR TZ EDITOR PAGER
HOSTNAME RANDOM SECONDS LINENO BASH BASH_VERSION BASH_SOURCE BASH_REMATCH FUNCNAME PIPESTATUS REPLY OPTARG
OPTIND OPTERR PPID UID EUID BASHPID PS1 PS4 CDPATH SHLVL COLUMNS LINES CI DEBUG NO_COLOR FORCE_COLOR
RUST_LOG RUST_BACKTRACE CARGO_TARGET_DIR NODE_ENV NODE_OPTIONS PYTHONPATH PYTHONUNBUFFERED VIRTUAL_ENV
GOPATH GOOS GOARCH CC CXX CFLAGS LDFLAGS GIT_PAGER""".split()
TEST_OPERATORS = "-a -b -c -d -e -f -g -h -k -p -r -s -t -u -w -x -G -L -N -O -S -z -n -o -v -R " \
                 "-eq -ne -lt -le -gt -ge -ef -nt -ot".split()
# Path pieces and special words that carry no private data but shape common commands.
# A run of these joined by `/` is kept too (`/dev/null`, `/usr/bin/env`).
SPECIAL = """_ dev null stdin stdout stderr tty zero urandom fd tmp usr bin local etc""".split()

NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_+-]{0,39}$")
SUB_RE = re.compile(r"^[a-z][a-z0-9-]{0,29}$")
OPT_RE = re.compile(r"^--?[A-Za-z0-9][A-Za-z0-9-]{0,39}$")
UPPER_RE = re.compile(r"^[A-Z][A-Z0-9_]{0,39}$")
DELIM_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,19}$")


def load_vocab():
    words, opts, variables = check.load_vocabulary(VOCAB)
    return words, opts, variables


# ------------------------------------------------------------------ skeletons

# A run is what one placeholder replaces in a word: identifier-ish characters joined by
# path-like punctuation. Glob, brace, tilde, `=` and `,` structure stays visible.
RCH = r"A-Za-z0-9_\u0080-\U0010FFFF\x00-\x08\x0b-\x1f\x7f"
RUN_RE = re.compile(rf"[{RCH}]+(?:[./@%+:-]+[{RCH}]+)*")
IDENT_CH = re.compile(rf"[{RCH}]")
# The option name takes all word characters, so what follows it never starts with one and
# cannot merge with a placeholder (`-pix_fmt` is one option, not `-w1w2`).
OPT_SPLIT_RE = re.compile(rf"^(--?)([A-Za-z0-9][{RCH}-]*)(.*)$", re.S)


def seg_word(text, out):
    """Unquoted text: placeholder each run, keep the punctuation between runs."""
    pos = 0
    for m in RUN_RE.finditer(text):
        if m.start() > pos:
            out.append(("t", text[pos:m.start()]))
        out.append(("w", m.group()))
        pos = m.end()
    if pos < len(text):
        out.append(("t", text[pos:]))


def seg_option(text, out):
    m = OPT_SPLIT_RE.match(text)
    if not m:
        seg_word(text, out)
        return
    out.append(("o", m.group(1) + m.group(2)))
    seg_word(m.group(3), out)


def seg_quoted(text, out, special):
    """Text inside quotes: everything between the characters in `special` (which keep
    their meaning there) becomes one placeholder, even a vocabulary word: quoted text is
    data (messages, patterns, programs), never syntax. Leading and trailing punctuation
    of a stretch stays, so `"$x.txt"` cannot turn into `"$v1w1"`."""
    i, n = 0, len(text)
    while i < n:
        ch = text[i]
        if ch == "\\" and "\\" in special and i + 1 < n:
            out.append(("t", text[i:i + 2]) if text[i + 1] in special else ("t", "\\"))
            i += 2 if text[i + 1] in special else 1
            continue
        if ch in special:
            out.append(("t", ch))
            i += 1
            continue
        j = i
        while j < n and text[j] not in special:
            j += 1
        stretch = text[i:j]
        idx = [k for k, c in enumerate(stretch) if IDENT_CH.match(c)]
        if idx:
            a, b = idx[0], idx[-1] + 1
            if a:
                out.append(("t", stretch[:a]))
            out.append(("q", stretch[a:b]))
            if b < len(stretch):
                out.append(("t", stretch[b:]))
        else:
            out.append(("t", stretch))
        i = j


PARSER = None


def node_text(n, src):
    return src[n.start_byte:n.end_byte].decode("utf-8", "replace")


def template(cmd):
    """Parse one command. Returns (segments, candidates, has_error). Segments are
    ("t", text) kept as is, ("q", quoted text) always a placeholder, ("w", word),
    ("o", option), ("v", variable): the last three are decided against the vocabulary
    when rendering."""
    global PARSER
    if PARSER is None:
        PARSER = ts.Parser(ts.Language(tsb.language()))
    src = cmd.encode("utf-8", "replace")
    tree = PARSER.parse(src)
    overrides = []  # (start, end, segments)
    cands = []

    def add(n, segs):
        overrides.append((n.start_byte, n.end_byte, segs))

    stack = [tree.root_node]
    while stack:
        n = stack.pop()
        t = n.type
        if t == "variable_name":
            name = node_text(n, src)
            add(n, [("v", name)])
            if UPPER_RE.match(name):
                cands.append(("var", name))
            continue
        if t in ("word", "number", "test_operator") and n.child_count == 0:
            text = node_text(n, src)
            segs = []
            if text.startswith("-"):
                seg_option(text, segs)
                m = OPT_SPLIT_RE.match(text)
                if m and t != "test_operator" and OPT_RE.match(m.group(1) + m.group(2)):
                    cands.append(("opt", m.group(1) + m.group(2)))
            else:
                seg_word(text, segs)
            add(n, segs)
            continue
        if t in ("string_content",):
            segs = []
            seg_quoted(node_text(n, src), segs, '$`"\\')
            add(n, segs)
            continue
        if t == "raw_string" and re.fullmatch(r"'[^']*'", node_text(n, src)):
            text = node_text(n, src)
            segs = [("t", "'")]
            seg_quoted(text[1:-1], segs, "")
            segs.append(("t", "'"))
            add(n, segs)
            continue
        if t == "ansi_c_string" and re.fullmatch(r"\$'.*'", node_text(n, src), re.S):
            text = node_text(n, src)
            segs = [("t", text[:2])]
            seg_quoted(text[2:-1], segs, "'\\")
            segs.append(("t", "'"))
            add(n, segs)
            continue
        if t == "heredoc_body":
            text = node_text(n, src)
            tail = text[text.rfind("\n") + 1:] if "\n" in text else ""
            add(n, [("t", "w0\n" + tail if tail.strip() == "" else "w0\n")])
            continue
        if t == "comment":
            add(n, [("t", "# w0")])
            continue
        if t == "heredoc_start":
            m = re.search(rf"[{RCH}]+", node_text(n, src))
            if m and DELIM_RE.match(m.group()):
                cands.append(("delim", m.group()))
        if t == "command":
            name = n.child_by_field_name("name")
            if name is not None:
                nm = node_text(name, src)
                if NAME_RE.match(nm):
                    cands.append(("cmd", nm))
                    if nm in SUBCMD_TOOLS:
                        for a in n.children_by_field_name("argument"):
                            av = node_text(a, src)
                            if a.type == "word" and not av.startswith("-"):
                                if SUB_RE.match(av):
                                    cands.append(("sub", av))
                                break
        stack.extend(n.children)

    overrides.sort()
    segs, pos = [], 0
    for s, e, ss in overrides:
        if s < pos:  # cannot happen for a tree; be safe
            continue
        if s > pos:
            seg_word(src[pos:s].decode("utf-8", "replace"), segs)
        segs.extend(ss)
        pos = e
    if pos < len(src):
        seg_word(src[pos:].decode("utf-8", "replace"), segs)
    # Two nodes can touch inside one shell word where tree-sitter splits it (seen in
    # misparsed here-docs); one placeholder each would glue into a token like `iw1`.
    merged = []
    for seg in segs:
        if seg[0] in "wq" and merged and merged[-1][0] in "wq":
            merged[-1] = ("q" if "q" in (seg[0], merged[-1][0]) else "w", merged[-1][1] + seg[1])
        else:
            merged.append(seg)
    return merged, cands, tree.root_node.has_error


def render(segs, words, opts, variables):
    wmap, vmap, out = {}, {}, []

    def ph(m, prefix, key):
        if key not in m:
            m[key] = f"{prefix}{len(m) + 1}"
        return m[key]

    for kind, text in segs:
        if kind == "t":
            out.append(text)
        elif kind == "w":
            keep = text in words or re.fullmatch(r"[0-9]", text) or all(p in words for p in text.split("/"))
            out.append(text if keep else ph(wmap, "w", text))
        elif kind == "q":
            out.append(ph(wmap, "w", text))
        elif kind == "o":
            if text in opts:
                out.append(text)
            else:
                dashes = "--" if text.startswith("--") else "-"
                out.append(dashes + ph(wmap, "w", text[len(dashes):]))
        elif kind == "v":
            out.append(text if text in variables or re.fullmatch(r"[0-9]", text) else ph(vmap, "v", text))
    return "".join(out)


# ------------------------------------------------------------------ corpus

def read_corpus():
    """Unique commands with their occurrence count, sessions and working directories."""
    info = {}
    with open(os.path.join(DATA, "commands.jsonl"), encoding="utf-8") as fh:
        for line in fh:
            d = json.loads(line)
            c = d["cmd"]
            if not c.strip():
                continue
            e = info.get(c)
            if e is None:
                e = info[c] = [0, set(), set()]
            e[0] += 1
            e[1].add(d.get("sid"))
            e[2].add(d.get("cwd"))
    return info


def project(cwd):
    """A working directory's project: its first four path components, worktrees folded
    into their checkout, so one project's many worktrees and subdirectories count once."""
    if not cwd:
        return None
    cwd = re.split(r"/\.?worktrees/", cwd)[0]
    return "/".join(cwd.replace("\\", "/").split("/")[:5])


def templates(cmds):
    with Pool(min(12, os.cpu_count() or 4)) as pool:
        return pool.map(template, cmds, chunksize=500)


def cmd_vocab(args):
    info = read_corpus()
    cmds = list(info)
    res = templates(cmds)
    per = defaultdict(lambda: [0, set(), set()])
    for c, (_, cands, _) in zip(cmds, res):
        cnt, sids, cwds = info[c]
        projects = {project(d) for d in cwds}
        for cand in set(cands):
            p = per[cand]
            p[0] += 1
            p[1] |= sids
            p[2] |= projects
    fixed_words = set(KEYWORDS + BUILTINS + UTILITIES + NEVER + SPECIAL)
    fixed_opts = set(TEST_OPERATORS)
    fixed_vars = set(VARIABLES)
    freq = {"cmd": set(), "sub": set(), "opt": set(), "var": set(), "delim": set()}
    for (kind, text), (n, sids, projects) in per.items():
        if n >= MIN_CMDS and len(sids) >= MIN_SESSIONS and len(projects) >= MIN_PROJECTS:
            freq[kind].add(text)
    freq["var"] = {v for v in freq["var"] if "_" not in v or v.startswith(PUBLIC_VAR_PREFIXES)}
    sections = [
        ("words", "Shell keywords and builtins (bash manual)", KEYWORDS + BUILTINS),
        ("words", "Utility names (research/builtins.md tiers 1-3)", UTILITIES),
        ("words", "Never-builtins: interpreters, toolchains, clients (research/builtins.md 4.5)", NEVER),
        ("words", "Path pieces and special words", SPECIAL),
        ("words", "Command names frequent in the corpus", sorted(freq["cmd"] - fixed_words)),
        ("words", "Subcommands of never-builtins frequent in the corpus", sorted(freq["sub"] - fixed_words - freq["cmd"])),
        ("words", "Here-doc delimiters frequent in the corpus", sorted(freq["delim"] - fixed_words - freq["cmd"] - freq["sub"])),
        ("variables", "Special and well-known variables", VARIABLES),
        ("variables", "Upper-case variables frequent in the corpus", sorted(freq["var"] - fixed_vars)),
        ("options", "test / [[ ]] operators", TEST_OPERATORS),
        ("options", "Option tokens frequent in the corpus", sorted(freq["opt"] - fixed_opts)),
    ]
    lines = [
        "# Vocabulary of the shape corpus: the only words tests/shapes/shapes.txt may contain",
        "# besides placeholders (w1.., v1..), w0 and single digits. Generated by",
        "# `scripts/shape-corpus vocab`; review every change by hand. Frequent words need",
        f"# >= {MIN_CMDS} distinct commands, >= {MIN_SESSIONS} sessions and >= {MIN_PROJECTS} projects.",
        "# Sections: [words] any position; [variables] after $ / in assignments; [options] -x / --long.",
    ]
    for kind, title, items in sections:
        lines.append("")
        lines.append(f"[{kind}] # {title}")
        seen = set()
        for w in items:
            if w not in seen:
                seen.add(w)
                lines.append(w)
    os.makedirs(OUT, exist_ok=True)
    with open(VOCAB, "w") as fh:
        fh.write("\n".join(lines) + "\n")
    print("wrote", VOCAB, {k: len(v) for k, v in freq.items()})


VIOLATIONS = []


def build_shapes():
    """Returns (shapes Counter of skeleton -> [count, sessions], per-command map, stats)."""
    words, opts, variables = load_vocab()
    info = read_corpus()
    cmds = list(info)
    res = templates(cmds)
    shapes = {}
    per_cmd = {}
    stats = Counter()
    for c, (segs, _, err) in zip(cmds, res):
        sk = render(segs, words, opts, variables)
        cnt, sids, _ = info[c]
        stats["commands"] += cnt
        stats["unique_commands"] += 1
        if err:
            stats["tree_sitter_errors"] += 1
        bad = check.violations(sk, words, opts, variables)
        if bad:
            stats["dropped_privacy"] += 1
            for tok in bad:
                # Debug aid that shows only the token's shape, never its letters.
                shown = re.sub(r"[A-Za-z0-9_]+", lambda m: m.group() if check.piece_ok(m.group(), words, variables)
                               else re.sub(r"[0-9]", "9", re.sub(r"[A-Za-z]", "a", m.group())), tok)
                stats["violation " + shown[:40]] += 1
            VIOLATIONS.append(re.sub(r"[A-Za-z0-9_]+", lambda m: m.group() if check.piece_ok(m.group(), words, variables)
                                     or m.group() in opts else "X", sk))
            continue
        per_cmd[c] = sk
        e = shapes.get(sk)
        if e is None:
            e = shapes[sk] = [0, set()]
        e[0] += cnt
        e[1] |= sids
    return shapes, per_cmd, stats


# Selection (D1033). Every skeleton seen in at least two sessions is written. Skeletons
# from a single session are written only while they add syntax not yet covered (see
# features()), shortest first, up to TAIL_BYTES, and never longer than MAX_SKELETON.
MIN_SHAPE_SESSIONS = 2
TAIL_BYTES = 2 * 1024 * 1024
MAX_SKELETON = 4096
FEATURE_TOKEN_RE = re.compile(r"[A-Za-z0-9_]+|\n|[^\sA-Za-z0-9_]")
SYNTAX_WORDS = set(KEYWORDS) | {"w0"}


def features(sk):
    """4-grams of syntax tokens: punctuation, newlines and keywords as themselves,
    every other word as `W`."""
    toks = []
    for t in FEATURE_TOKEN_RE.findall(sk):
        if t[0].isalnum() or t[0] == "_":
            t = t if t in SYNTAX_WORDS else "W"
        toks.append(t)
    return {tuple(toks[i:i + 4]) for i in range(max(1, len(toks) - 3))}


def cmd_build(args):
    shapes, _, stats = build_shapes()
    stats["unique_skeletons"] = len(shapes)
    for sk, (n, sids) in shapes.items():
        kind = "multi_session" if len(sids) >= 2 else ("one_session_repeated" if n >= 2 else "once")
        stats[f"{kind}_skeletons"] += 1
        stats[f"{kind}_commands"] += n
        stats[f"{kind}_bytes"] += len(check.escape(sk)) + 8
    chosen = {sk: n for sk, (n, sids) in shapes.items() if len(sids) >= MIN_SHAPE_SESSIONS}
    stats["written_multi_session"] = len(chosen)
    seen = set()
    for sk in chosen:
        seen |= features(sk)
    tail = sorted((sk for sk, (n, sids) in shapes.items() if len(sids) < MIN_SHAPE_SESSIONS),
                  key=lambda sk: (len(sk), sk))
    size = 0
    for sk in tail:
        if len(sk) > MAX_SKELETON:
            continue
        f = features(sk)
        if f <= seen:
            continue
        line = len(check.escape(sk).encode()) + 8
        if size + line > TAIL_BYTES:
            break
        seen |= f
        chosen[sk] = shapes[sk][0]
        size += line
        stats["written_one_session"] += 1
    out = [f"{n}\t{check.escape(sk)}\n" for sk, n in sorted(chosen.items(), key=lambda kv: (-kv[1], kv[0]))]
    stats["written"] = len(out)
    stats["written_commands"] = sum(chosen.values())
    stats["written_bytes"] = sum(len(x.encode()) for x in out)
    stats["features_covered"] = len(seen)
    stats["features_total"] = len(set().union(*(features(sk) for sk in shapes if len(sk) <= MAX_SKELETON)))
    with open(SHAPES, "w") as fh:
        fh.write("".join(out))
    os.makedirs(SCRATCH, exist_ok=True)
    with open(os.path.join(SCRATCH, "violations.txt"), "w") as fh:
        fh.write("".join(check.escape(v)[:300] + "\n" for v in VIOLATIONS))
    for k, v in stats.items():
        print(f"{k}\t{v}")
    sys.exit(check.main([SHAPES, VOCAB]))


def bash_ok(text):
    try:
        p = subprocess.run([BASH, "-n"], input=text.encode(), capture_output=True, timeout=10)
        return p.returncode == 0, p.stderr.decode("utf-8", "replace")[-300:]
    except subprocess.TimeoutExpired:
        return None, "timeout"


def cmd_parsecheck(args):
    import hashlib
    syntax = json.load(open(os.path.join(DATA, "syntax.json")))
    _, per_cmd, stats = build_shapes()
    sks = sorted(set(per_cmd.values()))
    with Pool(min(12, os.cpu_count() or 4)) as pool:
        verdict = dict(zip(sks, pool.map(bash_ok, sks, chunksize=200)))
    c = Counter()
    bad = Counter()
    for cmd, sk in per_cmd.items():
        orig = syntax.get(hashlib.sha1(cmd.encode("utf-8", "replace")).hexdigest(), [None])[0]
        ok, err = verdict[sk]
        c[(orig, ok)] += 1
        if orig and not ok:
            bad[sk] += 1
    for k, v in sorted(c.items(), key=str):
        print(f"original_ok={k[0]} skeleton_ok={k[1]}\t{v}")
    os.makedirs(SCRATCH, exist_ok=True)
    with open(os.path.join(SCRATCH, "parse-regressions.txt"), "w") as fh:
        for sk, n in bad.most_common():
            fh.write(f"{n}\t{check.escape(sk)}\t{check.escape(verdict[sk][1])}\n")
    print("regressions (skeletons only) in", os.path.join(SCRATCH, "parse-regressions.txt"))


SELF_TESTS = [
    ("cd /Users/x/y && cargo test --release -p my-crate 2>&1 | head -50",
     "cd /w1 && cargo test --release -p w2 2>&1 | head -w3"),
    ("cat <<'EOF' > /tmp/x.py\nimport os\nprint('$x')\nEOF\npython3 /tmp/x.py",
     "cat <<'EOF' > /w1\nw0\nEOF\npython3 /w1"),
    ("for f in src/*.rs; do echo \"$f: $(wc -l < \"$f\")\"; done",
     'for v1 in w1/*.w2; do echo "$v1: $(wc -w3 < "$v1")"; done'),
    ('git commit -m "fix: it\'s \\"really\\" status" && git status',
     'git w1 -w2 "w3 \\"w4\\" w5" && git status'),
    ("mysql -uroot -psecret --password=hunter2 -e 'select 1' $'a\\nb\\'c'",
     "mysql -w1 -w2 --w3=w4 -e 'w5' $'w6\\w7\\'w8'"),
    ('echo $((i+10)) ${x:-dflt} ${#arr[@]} "${HOME}/.cargo" ~/foo {a,b}.txt $1 $@ # note',
     'echo $((v1+w1)) ${v2:-w2} ${#v3[@]} "${HOME}/.w3" ~/w4 {w5,w6}.w7 $1 $@ # w0'),
    ("f() { local y=2; }; export A=1 Z; x=$(ls) && [[ $x =~ ^a(b)$ ]] && f",
     "w1() { local v1=2; }; export v2=1 v3; v4=$(ls) && [[ $v4 =~ ^w2(w3)$ ]] && w1"),
    ("find . -name '*.rs' -exec grep -l foo {} \\; -print0 | xargs -0 -I{} cat {} >/dev/null",
     "find . -name '*.w1' -exec grep -w2 w3 {} \\; -print0 | xargs -0 -I{} cat {} >/dev/null"),
    ('echo "$a $b" $x.txt "$y.log" ffmpeg -pix_fmt yuv420p', 'echo "$v1 $v2" $v3.w1 "$v4.w2" ffmpeg -w3 w4'),
    ("cat <<-END\n\tbody\n\tEND\nwhile read -r line; do :; done < <(ls)",
     "cat <<-w1\n\tw0\n\tw1\nwhile read -r w2; do :; done < <(ls)"),
]


def cmd_selftest(args):
    """Skeletons of hand-written commands against the fixed vocabulary lists only."""
    words = set(KEYWORDS + BUILTINS + UTILITIES + NEVER + SPECIAL + ["EOF", "test", "status"])
    opts = set(TEST_OPERATORS + ["--release", "-0", "-I", "-exec", "-name", "-print0"])
    variables = set(VARIABLES)
    failed = 0
    for cmd, want in SELF_TESTS:
        got = render(template(cmd)[0], words, opts, variables)
        bad = check.violations(got, words, opts, variables)
        if got != want or bad:
            failed += 1
            print(f"FAIL: {cmd!r}\n  want {want!r}\n  got  {got!r}\n  violations {bad}")
    print(f"shape-corpus: self-test {len(SELF_TESTS) - failed}/{len(SELF_TESTS)} ok")
    sys.exit(1 if failed else 0)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    fn = {"vocab": cmd_vocab, "build": cmd_build, "parsecheck": cmd_parsecheck, "selftest": cmd_selftest}.get(cmd)
    if fn is None:
        sys.exit(__doc__)
    fn(sys.argv[2:])


if __name__ == "__main__":
    main()
