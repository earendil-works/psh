=== 1: sourced script
status: 0
bash-n: 0
--- stdout
|About to source script
|Entered script
|a
|b
|c
|Exiting script
|Back from script
--- stderr
|+ echo 'About to source script'
|+ source script.sh
|++ echo 'Entered script'
|++ for f in a b c
|++ echo a
|++ for f in a b c
|++ echo b
|++ for f in a b c
|++ echo c
|++ echo 'Exiting script'
|+ echo 'Back from script'

