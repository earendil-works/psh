|#!/bin/sh
|d=$PWD
|while :; do
|  if [ -x "$d/node_modules/.bin/$1" ]; then t=$1; shift; exec "$d/node_modules/.bin/$t" "$@"; fi
|  [ "$d" = / ] && break
|  d=$(dirname "$d")
|done
|echo "npm error could not determine executable to run" >&2
|exit 1
